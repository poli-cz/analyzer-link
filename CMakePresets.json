{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "LINK_BUILD_TESTS": "ON" }
    },
    { "name": "debug", "displayName": "Debug", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "displayName": "Release", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "asan", "displayName": "Debug + AddressSanitizer + UBSan", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LINK_ENABLE_SANITIZERS": "ON" } },
    { "name": "tidy", "displayName": "Debug + clang-tidy", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LINK_ENABLE_CLANG_TIDY": "ON" } }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_container_overflow=0",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1" } },
    { "name": "tidy", "inherits": "base", "configurePreset": "tidy" }
  ]
}
